# Пример окружения. Скопируйте в .env и при необходимости поправьте.
# Файл .env в git не попадает.

# Kaggle (скачивание датасета roopacalistus/superstore)
KAGGLE_API_KEY=

# --- Greenplum: локальный Docker (основной путь) ---
GP_HOST=localhost
GP_PORT=15432
GP_USER=gpadmin
GP_PASSWORD=
GP_DATABASE=vault_dv
GP_MAINT_DB=postgres
GP_SSLMODE=prefer

